GET http://localhost:5000

### TITLES

GET http://localhost:5000

###

GET http://localhost:5000/titles

###

GET http://localhost:5000/titles?type=novel&page=2&limit=10

###

GET http://localhost:5000/titles/{{titleId}}

### 

# @name createTitle
POST http://localhost:5000/titles
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "name": "Teste com contents e genres e erro",
    "synopsis": "Sinópse Teste",
    "cover_url": "http://teste.com/cover.png",
    "banner_url": "http://teste.com/banner.png",
    "type": "novel",
    "age_rating": "L",
    "status": "completed",
    "source": "http://teste.com/source",
    "publication_year": 2026,
    "genre_ids": [3, 2]
}

@titleId = {{createTitle.response.body.id}}

###

PATCH http://localhost:5000/titles/{{titleId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "age_rating": "18",
    "genre_ids": [2, 5]
}

###

DELETE http://localhost:5000/titles/{{titleId}}
Authorization: Bearer {{authToken}}

### CONTENTS

# @name createContents
POST http://localhost:5000/titles/{{titleId}}/contents
Authorization: Bearer {{authToken}}
Content-Type: application/json

[
  {
    "title": "Episodio 1: Eu Ja Estou Acostumado",
    "season": 1,
    "episode": 1.0,
    "language": "sub",
    "source_url": "https://stream-provider.com/ep1.mp4"
  },
  {
    "title": "Episodio 2: Se Eu Tivesse Mais Uma Chance",
    "season": 1,
    "episode": 2.0,
    "language": "sub",
    "source_url": "https://stream-provider.com/ep2.mp4"
  }
]

