### PROFILES

@profileId = 11111111-1111-1111-1111-111111111111

GET http://localhost:5000/profiles

###

GET http://localhost:5000/profiles/{{profileId}}

###

PATCH http://localhost:5000/profiles/{{profileId}}
Content-Type: application/json

{
    "username": "filipe_dev",
    "avatar_url": "https://exemplo.com/avatar.png"
}

###

PATCH http://localhost:5000/profiles/{{profileId}}/role
Content-Type: application/json

{
    "role": "admin"
}

### FAVORITES

POST http://localhost:5000/profiles/{{profileId}}/favorites/10

###

GET http://localhost:5000/profiles/{{profileId}}/favorites

###

DELETE http://localhost:5000/profiles/{{profileId}}/favorites/5

### ARTS

# @name createArt
POST http://localhost:5000/arts
Content-Type: application/json

{
    "profile_id": "{{profileId}}",
    "title": "Minha Primeira Fanart do Goku",
    "description": "Feito no iPad Pro. Deu muito trabalho!",
    "image_url": "https://storage.exemplo.com/arts/goku-super.png"
}

@artId = {{createArt.response.body.id}}

###

GET http://localhost:5000/arts

###

GET http://localhost:5000/arts/{{artId}}

###

PATCH http://localhost:5000/arts/{{artId}}
Content-Type: application/json

{
    "description": "Goku SSJ4 (Editado)"
}

###

POST http://localhost:5000/arts/{{artId}}/likes/{{profileId}}

###

DELETE http://localhost:5000/arts/{{artId}}/likes/{{profileId}}

###

DELETE http://localhost:5000/arts/{{artId}}