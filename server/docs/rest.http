# Sign Up
# @name signup
POST {{$dotenv SUPABASE_URL}}/auth/v1/signup
apikey: {{$dotenv SUPABASE_KEY}}
Content-Type: application/json

{
    "email": "dev_gv4@teste.com",
    "password": "senha123456"
}

###

# Token JWT
# @name login
POST {{$dotenv SUPABASE_URL}}/auth/v1/token?grant_type=password
apikey: {{$dotenv SUPABASE_KEY}}
Content-Type: application/json

{
    "email": "dev_gv2@teste.com",
    "password": "senha123456"
}

###

# Token JWT
# @name login
POST {{$dotenv SUPABASE_URL}}/auth/v1/token?grant_type=password
apikey: {{$dotenv SUPABASE_KEY}}
Content-Type: application/json

{
    "email": "dev_gv@teste.com",
    "password": "senha123456"
}

###

@authToken = {{login.response.body.access_token}}

###

GET http://localhost:5000/profiles/{{profileId}}

###

GET http://localhost:5000/profiles/me
Authorization: Bearer {{authToken}}

###

